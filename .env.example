# ---------------------------------------------------------------------------
# Saint Paul Finance — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione valores reais.
# ---------------------------------------------------------------------------

# Postgres gerenciado (Neon, Supabase Postgres ou Vercel Postgres).
# Use a string com pooling para runtime serverless.
DATABASE_URL=

# Conexão direta (sem pooler). Usada por `npm run migrate`.
# Se o provedor não distinguir, repita o valor de DATABASE_URL.
DIRECT_DATABASE_URL=

# Segredo de assinatura das sessões. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Primeiro acesso administrativo, criado por `npm run seed`.
ADMIN_EMAIL=
ADMIN_NOME=
# Hash gerado por `npm run hash-senha`. Nunca guarde a senha em texto puro.
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# IA. Usada apenas no servidor, nunca no navegador.
# Sem chave alguma, as rotas de IA respondem 503 com mensagem legível e o
# cadastro manual continua funcionando.
#
# Provedor: "groq" ou "anthropic". Sem esta variável, vale a chave configurada
# (Anthropic tem precedência quando as duas existem).
IA_PROVEDOR=groq

# Groq: API compatível com a da OpenAI. Não tem cache de prompt e os modelos de
# texto não leem PDF — nesse caso a triagem usa os artigos relevantes do
# Estatuto e pede o texto colado para PDF.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic: tem cache de prompt (o Estatuto integral vai no prefixo) e lê PDF
# e imagem nativamente.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Vercel Blob, para anexos e documentos.
# Sem ela, o upload de arquivo é recusado com mensagem legível e o
# fluxo de texto colado continua disponível.
BLOB_READ_WRITE_TOKEN=

# URL pública da aplicação (sem barra final).
NEXT_PUBLIC_APP_URL=http://localhost:3000
